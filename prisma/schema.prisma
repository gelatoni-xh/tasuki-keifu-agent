generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AgentRunStatus {
  running
  need_clarification
  completed
  failed
}

enum AgentEventLevel {
  debug
  info
  warn
  error
}

enum GovernanceBatchStatus {
  running
  completed
  failed
}

enum GovernanceSubjectStatus {
  pending
  completed
  held
  failed
}

enum ActionRiskLevel {
  low
  medium
  high
}

enum ActionExecutionStatus {
  planned
  held
  skipped
  succeeded
  failed
}

model AgentRun {
  id           String         @id
  graphName    String
  status       AgentRunStatus @default(running)
  input        Json
  output       Json?
  currentNode  String?
  threadId     String?
  startedAt    DateTime       @default(now())
  endedAt      DateTime?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  checkpoints  AgentCheckpoint[]
  events       AgentEvent[]
  diagnosis    DiagnosisResult?
  governanceSubject GovernanceSubject?

  @@index([graphName, startedAt])
  @@index([status, startedAt])
}

model GovernanceBatch {
  id        String                @id
  status    GovernanceBatchStatus @default(running)
  dryRun    Boolean               @default(true)
  input     Json
  summary   Json?
  startedAt DateTime              @default(now())
  endedAt   DateTime?
  errorMessage String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  subjects  GovernanceSubject[]

  @@index([status, startedAt])
}

model GovernanceSubject {
  id                String                  @id @default(cuid())
  batchId           String
  personId          String
  personSlug        String
  businessUpdatedAt DateTime
  diagnosisRunId    String?                 @unique
  status            GovernanceSubjectStatus @default(pending)
  riskLevel         ActionRiskLevel?
  findings          Json?
  actionBundle      Json?
  holdReason        String?
  completedAt       DateTime?
  errorMessage      String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  batch             GovernanceBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  diagnosisRun      AgentRun?                @relation(fields: [diagnosisRunId], references: [id], onDelete: SetNull)
  actionExecutions  ActionExecution[]

  @@unique([batchId, personId])
  @@index([personId, completedAt])
  @@index([status, completedAt])
}

model ActionExecution {
  id             String                @id @default(cuid())
  subjectId      String
  actionCode     String
  idempotencyKey String
  status         ActionExecutionStatus @default(planned)
  action         Json
  result         Json?
  errorMessage   String?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  subject        GovernanceSubject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, actionCode])
  @@index([subjectId, createdAt])
  @@index([idempotencyKey, status])
  @@index([status, createdAt])
}

model AgentCheckpoint {
  id        String   @id @default(cuid())
  runId     String
  nodeName  String
  state     Json
  createdAt DateTime @default(now())

  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([nodeName, createdAt])
}

model AgentEvent {
  id        String          @id @default(cuid())
  runId     String
  nodeName  String?
  level     AgentEventLevel @default(info)
  message   String
  payload   Json?
  createdAt DateTime        @default(now())

  run       AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([level, createdAt])
}

model DiagnosisResult {
  id          String   @id @default(cuid())
  runId       String   @unique
  personId    String?
  personSlug  String?
  status      String
  summary     String?
  findings    Json
  actions     Json
  snapshot    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([personSlug])
  @@index([personId])
  @@index([status, createdAt])
}
