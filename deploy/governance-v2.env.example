# Main business DB with the governance schema; never the legacy Agent-only DB.
GOVERNANCE_DATABASE_URL=postgresql://governance_runtime:CHANGE_ME@tasuki-keifu-postgres:5432/tasuki_keifu
GOVERNANCE_READ_DATABASE_URL=postgresql://governance_reader:CHANGE_ME@tasuki-keifu-postgres:5432/tasuki_keifu
GOVERNANCE_PAYLOAD_DIR=/var/lib/tasuki-governance/payloads
GOVERNANCE_WRITE_ENABLED=false
# Model is explicit; no automatic model/account inference from local Codex files.
GOVERNANCE_RESEARCH_MODEL=
GOVERNANCE_RESEARCH_REQUESTS=3
GOVERNANCE_RESEARCH_TIMEOUT_MS=25000
GOVERNANCE_CHECKPOINT_RETENTION_DAYS=7
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
GOVERNANCE_MAIL_ENABLED=false
GOVERNANCE_SMTP_HOST=
GOVERNANCE_SMTP_PORT=465
GOVERNANCE_SMTP_SECURE=true
GOVERNANCE_SMTP_USER=
GOVERNANCE_SMTP_PASSWORD=
GOVERNANCE_MAIL_FROM=
GOVERNANCE_MAIL_TO=
